{
  "name": "ovlive-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/validate-realtime-assets.mjs && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "ndov:selftest": "node scripts/ndov-stream-selftest.mjs",
    "ndov:build-crosswalk": "python3 scripts/build-ndov-trip-crosswalk.py",
    "ndov:plan-selftest": "node scripts/ndov-plan-cancellation-selftest.mjs",
    "ndov:continuous-selftest": "node scripts/ndov-continuous-collector-selftest.mjs",
    "ndov:kv78-delay-selftest": "node scripts/ndov-kv78-delay-selftest.mjs",
    "ndov:tram-metro-selftest": "node scripts/ndov-stream-selftest.mjs && node scripts/ndov-kv78-delay-selftest.mjs && node scripts/ndov-openov-route-crossmatch-selftest.mjs",
    "ovapi:match-selftest": "node scripts/ovapi-transitous-match-selftest.cjs",
    "ndov:kv6-live-selftest": "node scripts/ndov-kv6-live-selftest.mjs",
    "ndov:build-openov-route-crosswalk": "python3 scripts/build-ndov-openov-route-crosswalk.py",
    "ndov:openov-route-crossmatch-selftest": "node scripts/ndov-openov-route-crossmatch-selftest.mjs",
    "openov:prediction-selftest": "node scripts/openov-realtime-prediction-selftest.mjs",
    "openov:vehicle-position-fast-decode-selftest": "node scripts/openov-vehicle-position-fast-decode-selftest.mjs",
    "ns:realtime-selftest": "node scripts/ns-train-realtime-selftest.mjs",
    "api:rate-limit-selftest": "node scripts/api-rate-limit-selftest.mjs",
    "ndov:autocollect-safety-selftest": "node scripts/ndov-autocollect-safety-selftest.mjs",
    "ndov:validate-assets": "node scripts/validate-realtime-assets.mjs",
    "ndov:prediction-selftest": "node scripts/ndov-prediction-selftest.mjs",
    "ndov:metro-kv78-fallback-selftest": "node scripts/ndov-metro-kv78-fallback-selftest.mjs"
  },
  "dependencies": {
    "gtfs-realtime-bindings": "^1.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.40.0"
  }
}
